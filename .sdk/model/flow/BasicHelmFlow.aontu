# BasicHelmFlow

main: kit: flow: BasicHelmFlow:
{
  entity: "helm",
  kind: "basic",
  name: "BasicHelmFlow",
  step: [
    {
      i: {
        ref: "helm_ref01"
      }

      m: {
        identifier: "identifier01",
        owner: "owner01"
      }

      o: "create"
    }

    {
      m: {
        identifier: "identifier01",
        owner: "owner01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "helm_ref01"
          }
        }
      ]
    }

    {
      d: {
        identifier: "identifier01",
        owner: "owner01"
      }

      i: {
        ref: "helm_ref01",
        srcdatavar: "helm_ref01_data",
        suffix: "_up0",
        textfield: "auth_mode"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-helm_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "helm_ref01",
        srcdatavar: "helm_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "helm01",
        identifier: "identifier01",
        owner: "owner01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-helm_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicHelmFlow"
}