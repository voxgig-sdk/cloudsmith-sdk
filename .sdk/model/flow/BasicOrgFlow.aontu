# BasicOrgFlow

main: kit: flow: BasicOrgFlow:
{
  entity: "org",
  kind: "basic",
  name: "BasicOrgFlow",
  step: [
    {
      i: {
        ref: "org_ref01"
      }

      m: {
        org: "org01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "org_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "org_ref01",
        srcdatavar: "org_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-org_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "org_ref01",
        srcdatavar: "org_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "org01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-org_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "org_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "org01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "org_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicOrgFlow"
}