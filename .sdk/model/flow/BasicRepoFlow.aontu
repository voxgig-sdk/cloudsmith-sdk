# BasicRepoFlow

main: kit: flow: BasicRepoFlow:
{
  entity: "repo",
  kind: "basic",
  name: "BasicRepoFlow",
  step: [
    {
      i: {
        ref: "repo_ref01"
      }

      m: {
        identifier: "identifier01",
        owner: "owner01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "repo_ref01"
          }
        }
      ]
    }

    {
      d: {
        owner: "owner01"
      }

      i: {
        ref: "repo_ref01",
        srcdatavar: "repo_ref01_data",
        suffix: "_up0",
        textfield: "content_kind"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-repo_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "repo_ref01",
        srcdatavar: "repo_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "repo01",
        owner: "owner01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-repo_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "repo_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "repo01",
        owner: "owner01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "repo_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRepoFlow"
}