# BasicDockerFlow

main: kit: flow: BasicDockerFlow:
{
  entity: "docker",
  kind: "basic",
  name: "BasicDockerFlow",
  step: [
    {
      i: {
        ref: "docker_ref01"
      }

      m: {
        identifier: "identifier01",
        owner: "owner01"
      }

      o: "create"
    }

    {
      m: {
        identifier: "identifier01",
        owner: "owner01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "docker_ref01"
          }
        }
      ]
    }

    {
      d: {
        identifier: "identifier01",
        owner: "owner01"
      }

      i: {
        ref: "docker_ref01",
        srcdatavar: "docker_ref01_data",
        suffix: "_up0",
        textfield: "auth_mode"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-docker_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "docker_ref01",
        srcdatavar: "docker_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "docker01",
        identifier: "identifier01",
        owner: "owner01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-docker_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDockerFlow"
}